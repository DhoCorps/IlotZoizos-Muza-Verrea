{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    
    /* 🛡️ SUTURE MODERNE : Pas de baseUrl, résolution directe des chemins */
    "paths": {
      "@/*": ["./apps/hub-central/*"],
      "@ilot/*": ["./packages/*/src", "./apps/*/src"]
    },
    
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "next-env.d.ts",
    "declaration.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "packages/infrastructure/src/scripts/seed/seed-script.cjs",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "dist", ".next"]
}