    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.378.0",
    "mongoose": "^8.3.4",
    "next": "^14.2.3",
    "next-auth": "^4.24.13",
    "opentype.js": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
