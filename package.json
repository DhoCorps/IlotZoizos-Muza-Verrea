{
  "name": "ilot-zoizos-nexus",
  "version": "1.0.0",
  "private": true,
  "description": "Système nerveux central hybride",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "db:seed": "ts-node packages/infrastructure/src/scripts/seed.ts",
    "db:roundup": "ts-node packages/infrastructure/src/scripts/roundup.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "clean": "turbo run clean && rm -rf node_modules **/*/node_modules"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "@types/react": "^18.3.3",
      "@types/react-dom": "^18.3.0"
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.12",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/socket.io": "^3.0.2",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.0",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.6.0"
  },
  "dependencies": {
